# O Vite lê a mesma porta ao iniciar. Reinicie npm run dev após editar.
PORT=3000
LISTEN_HOST=127.0.0.1
# Para assistir por HTTP na mesma rede, use LISTEN_HOST=0.0.0.0 e informe a origem
# acessível pelo espectador, por exemplo http://192.168.1.10:3000.
VIEWER_ORIGIN=
STUN_URLS=stun:stun.l.google.com:19302

# Opcionais. URLs separadas por vírgula. Preencha os três campos juntos.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
